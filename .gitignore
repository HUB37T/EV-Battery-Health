# Python / notebooks
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Local environments
.venv/
venv/
env/
.conda/

# Secrets / credentials
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key

# Local datasets: keep folder markers and documentation
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.zip
*.7z

# Trained models and serialized preprocessing
models/*
!models/README.md
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.keras
*.onnx
*.pkl
*.pickle
*.joblib
checkpoints/

# Local run caches and logs; keep curated results versioned
runs/
wandb/
mlruns/
lightning_logs/
*.log

# Recomputed row-level EDA intermediates; curated aggregate tables stay tracked.
results/eda/temporal_pairs.csv
results/eda/battery_age_means.csv

# Recomputed row-level validation predictions; aggregate experiment results stay tracked.
!/results/experiments/runs/
results/experiments/runs/*/validation_predictions.csv

# Frozen-model test predictions are recreated locally; aggregate results stay tracked.
results/final_evaluation/predictions/

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
~$*
