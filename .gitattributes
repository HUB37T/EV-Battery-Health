# Normalize text files in Git; consistent across Windows and other systems.
* text=auto
*.md text eol=lf
*.py text eol=lf
*.ipynb text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Pipeline outputs are regenerated by code; collapse them in GitHub diffs.
results/** linguist-generated=true
results/**/*.html text eol=lf
results/**/*.svg text eol=lf
