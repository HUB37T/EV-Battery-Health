# Normalize text files in Git; consistent across Windows and other systems.
* text=auto
*.md text eol=lf
*.py text eol=lf
*.ipynb text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Generated reading copy and vector exports; source notebook stays reviewable.
results/eda/*.svg text eol=lf linguist-generated=true
results/eda/EDA_READING.html text eol=lf linguist-generated=true
results/preprocessing/PREPROCESSING_READING.html text eol=lf linguist-generated=true
results/experiments/EXPERIMENT_READING.html text eol=lf linguist-generated=true
results/feature_engineering/FEATURE_ENGINEERING_READING.html text eol=lf linguist-generated=true
